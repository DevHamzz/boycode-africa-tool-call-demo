# AI provider selection: deepseek, openai, anthropic
AI_PROVIDER=deepseek
WEB_SEARCH_PROVIDER=tavily

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Search APIs for live web results
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NextAuth
NEXTAUTH_SECRET=generate_a_strong_secret_here
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server networking
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Protect the remote API before exposing it publicly.
# Set this to a long random value and send it as x-api-key.
API_KEY=change_this_to_a_strong_random_value

# Leave empty to auto-select PowerShell on Windows or /bin/sh on Unix.
COMMAND_SHELL=
